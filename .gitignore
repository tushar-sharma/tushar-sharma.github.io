### Jekyll ###
_site/
.jekyll-cache/
tag/

# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite
 
# VIM
# ####################
*.swp

# Python #
######################
.venv

# Local environment files (may contain credentials)
.env
.env.*
!.env.example

# Plaintext sources for encrypted posts. Never commit these files.
.private-posts/
encrypted/*.md
encrypted/*.plain.html

# OS generated files #
######################
.DS_Store
.DS_Store?
_posts/.DS_Store
img/.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
